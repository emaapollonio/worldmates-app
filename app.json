{
  "expo": {
    "name": "MetMap",
    "slug": "metmap",
    "version": "1.0.0",
    "scheme": "metmap",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emaapollonio.metmap"
    },
    "android": {
      "package": "com.emaapollonio.metmap",
      "adaptiveIcon": {
        "backgroundColor": "#C0562B",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MetMap needs access to your photo gallery so you can add a photo of your friend.",
          "cameraPermission": "MetMap needs access to your camera so you can take a photo of your friend."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C0562B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MetMap uses Face ID to unlock the app for you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MetMap uses the camera to scan a friend's QR code."
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "c404c7e8-5038-4c7f-84d4-ba4b27a7c8f9"
      }
    },
    "owner": "emaapollonio"
  }
}
