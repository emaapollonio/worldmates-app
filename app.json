{
  "expo": {
    "name": "MetMap",
    "slug": "metmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C0562B",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MetMap potrebuje dostop do galerije, da dodaš fotografijo prijatelja.",
          "cameraPermission": "MetMap potrebuje dostop do kamere, da posnameš fotografijo prijatelja."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C0562B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
