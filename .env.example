# Kopiraj to datoteko v `.env` in izpolni s podatki iz Supabase.
# Supabase → Project Settings → API → Project URL in Project API key (anon / public).
# Vrednosti s predpono EXPO_PUBLIC_ so vgrajene v aplikacijo (anon ključ je javen po zasnovi – varuje ga RLS).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sentry → Project Settings → Client Keys (DSN). Neobvezno; brez njega je Sentry izklopljen.
# Dodaj ga tudi v EAS: npx eas env:create --name EXPO_PUBLIC_SENTRY_DSN --value <dsn> --environment preview --environment production --visibility sensitive
EXPO_PUBLIC_SENTRY_DSN=

# Google Cloud Console → APIs & Services → Credentials → API key (z omejitvijo "Maps SDK for Android").
# Bere se ob buildu (app.config.js), zato brez EXPO_PUBLIC_. Dodaj ga tudi v EAS:
# npx eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --value <ključ> --environment preview --environment production --visibility sensitive
GOOGLE_MAPS_ANDROID_API_KEY=
